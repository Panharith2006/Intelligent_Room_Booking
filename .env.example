# Django Core Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set USE_SQLITE=True for development with SQLite
# Set USE_SQLITE=False to use MySQL
USE_SQLITE=False

# MySQL Database Settings (used when USE_SQLITE=False)
DB_NAME=room_booking
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3307

# For Production MySQL (Railway, Render, etc.)
MYSQL_DATABASE=room_booking_db
MYSQL_USER=mysql_user
MYSQL_PASSWORD=secure_password
MYSQL_HOST=mysql-host.internal
MYSQL_PORT=3306

# Django Settings Module (change per environment)
# Options: room_booking_system.settings (default)
#          room_booking_system.settings_dev
#          room_booking_system.settings_staging
#          room_booking_system.settings_production
DJANGO_SETTINGS_MODULE=room_booking_system.settings

# CSRF & Security Settings
# Add your domains (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Integration Settings
# DeepSeek API (for chatbot/AI features)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Groq API (alternative AI provider)
GROQ_API_KEY=your-groq-api-key

# HuggingFace API (if using HF models)
HF_API_KEY=your-huggingface-api-key

# Google OAuth Settings (for Google Sign-In)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/accounts/google/callback/

# Google Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS_FILE=path/to/credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=path/to/token.json
GOOGLE_CALENDAR_ID=primary

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Redis Cache (for staging/production)
REDIS_URL=redis://localhost:6379/0

# Production Security Settings (set True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Static & Media Files (production)
STATIC_URL=/static/
MEDIA_URL=/media/

# CORS Settings (for frontend integration)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Development/Debug Settings
DJANGO_LOG_LEVEL=INFO
